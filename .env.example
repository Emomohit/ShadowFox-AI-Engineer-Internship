# ==============================================================================
# ShadowFox AI Engineering Portfolio - Environment Configuration Example
# Copy this file to .env and configure your API keys.
# DO NOT commit .env with real credentials.
# ==============================================================================

# LLM Provider: "gemini" (recommended) or "openai" or "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Names
# e.g., gemini-1.5-flash, gemini-1.5-pro, or gemini-2.0-flash
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# (Optional) OpenAI API Key if using provider="openai"
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Advanced Project FastAPI Backend URL (used by Streamlit frontend)
BACKEND_URL=http://localhost:8000

# RAG & Storage Configuration
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./faiss_index
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# Application Environment: development | production | test
APP_ENV=development
